# Backend API base URL (no trailing slash)
VITE_API_URL=https://api.example.com

# Public storage base (used for company logos / CV viewing)
VITE_STORAGE_URL=https://api.example.com/storage

# Reverb (websockets) public endpoint
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=ws.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
